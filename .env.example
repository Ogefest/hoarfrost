# hoarfrost instance settings. Secrets live here only and never enter the archive.

# PostgreSQL: schema app (users, queue, sources) and schema archive_index (rebuildable from storage).
HOARFROST_DATABASE=postgres://hoarfrost:password@localhost:5432/hoarfrost
# Local state: spool/, block lists.
HOARFROST_DATA_DIR=/var/lib/hoarfrost

# Archive storage: file:///path or s3://bucket/prefix?endpoint=https://host&region=r[&path_style=true]
HOARFROST_STORAGE=file:///srv/archive
# Optional asynchronous copy of every new object.
#HOARFROST_STORAGE_REPLICA=file:///mnt/backup/archive

# Additional storages (each one a complete, independent archive), chosen per
# source (Sources page) or per URL/upload ("storage" field).
#HOARFROST_STORAGES=press=s3://press-bucket/archive?endpoint=https://s3.example.com&region=eu-central,local=file:///srv/local
#HOARFROST_REPLICAS=press=file:///mnt/backup/press
# Per-storage S3 credentials (fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY):
#HOARFROST_S3_PRESS_ACCESS_KEY_ID=
#HOARFROST_S3_PRESS_SECRET_ACCESS_KEY=

# At least 32 random characters: password pepper. Keep a backup; see docs/operations.md.
HOARFROST_SECRET=
HOARFROST_LISTEN=:8080

# Workers: token for /internal/* (enables remote workers), parallel captures.
#HOARFROST_WORKER_TOKEN=
#HOARFROST_WORKERS=2
#HOARFROST_EMBEDDED_WORKER=true
#HOARFROST_COORDINATOR=https://archive.example.org   # for "hoarfrost worker"

# Epochs: wait after the end of the ISO week before sealing; keep incoming/ files for this long.
#HOARFROST_SEAL_GRACE=6h
#HOARFROST_INCOMING_RETENTION=30d
#HOARFROST_CONCAT_BY_SOURCE=false

#HOARFROST_CHROME=/usr/bin/chromium
#HOARFROST_USER_AGENT=
#HOARFROST_INSECURE_COOKIE=false   # only for plain-HTTP development setups
#HOARFROST_LOG_LEVEL=info
#HOARFROST_LOG_FORMAT=text

# S3 credentials
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# docker compose: host directory bind-mounted as the archive (default ./archive).
# HOARFROST_ARCHIVE_DIR=/mnt/disk/hoarfrost/archive
