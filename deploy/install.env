# hoarfrost settings for deploy/compose.yaml. Keep this file private and back
# it up: without HOARFROST_SECRET nobody can log in (see docs/install.md).
#
# Fill in the three secrets below with random values, for example:
#   openssl rand -hex 32
# or let sed do it:
#   sed -i "s/^POSTGRES_PASSWORD=$/POSTGRES_PASSWORD=$(openssl rand -hex 24)/; s/^HOARFROST_SECRET=$/HOARFROST_SECRET=$(openssl rand -hex 32)/; s/^HOARFROST_WORKER_TOKEN=$/HOARFROST_WORKER_TOKEN=$(openssl rand -hex 24)/" .env

# Password of the bundled PostgreSQL. Do not change it once the database exists.
POSTGRES_PASSWORD=
# At least 32 random characters: password pepper of the user accounts.
HOARFROST_SECRET=
# Shared secret for additional workers (docs/operations.md, step 2).
HOARFROST_WORKER_TOKEN=

# Image tag: "latest" or a release such as 0.1.0 (recommended: pin a version
# and change it deliberately when upgrading).
HOARFROST_VERSION=latest

# Where the archive (WARC/WACZ files) is kept. By default it is a Docker
# volume; use a host directory to see the files and back them up, e.g.
# /srv/hoarfrost/archive. It must be writable by the image user: chown it to
# the uid printed by `docker compose run --rm hoarfrost id -u`, or set
# "user:" for the hoarfrost service in a compose.override.yaml.
#HOARFROST_ARCHIVE_DIR=/srv/hoarfrost/archive
# Or S3-compatible storage instead of a directory:
#HOARFROST_STORAGE=s3://bucket/prefix?endpoint=https://s3.example.com&region=eu-central-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# The UI listens on 127.0.0.1:8080. Put it behind an HTTPS reverse proxy to
# expose it; for plain HTTP on a trusted network set HOARFROST_BIND=0.0.0.0
# and HOARFROST_INSECURE_COOKIE=true (cookies otherwise require HTTPS).
#HOARFROST_BIND=0.0.0.0
#HOARFROST_PORT=8080
#HOARFROST_INSECURE_COOKIE=true

# Parallel captures (raise it when the queue keeps growing).
#HOARFROST_WORKERS=2

# More settings: https://github.com/Ogefest/hoarfrost/blob/main/.env.example
